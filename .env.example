# PostgreSQL（Docker環境ではDB_HOST=db のまま使用）
DB_HOST=db
DB_NAME=thermo_db
DB_USER=thermo_user
DB_PASS=your_password_here

# JWT署名キー（例: python3 -c "import secrets; print(secrets.token_hex(32))" で生成）
SECRET_KEY=your_secret_key_here

# Microsoft Teams Webhook（不要な場合は空欄）
TEAMS_WEBHOOK_URL=

# おんどとり WebStorage API（使用する場合のみ設定）
API_KEY=
LOGIN_ID=
LOGIN_PASS=
